# Atalaya · Reglas locales de Snort 2.9 (HIDS en ec2-backend)
# Copiar a /etc/snort/rules/local.rules · SID 1000001-1000003 = las 3 reglas de la práctica; 1000004+ = ampliación
# Generado con npm run rules:export: edita src/domain/catalog/detectionCatalog.js

# ===== Objetivo 1 · ICMP (ping) =====
# Tráfico: ping -c 4 desde ec2-frontend (host de prueba) hacia la IP privada del backend (sensor).
# Por qué: Todo paquete ICMP cuyo destino esté en HOME_NET (subred 10.0.128.0/24) coincide. La respuesta del sensor va hacia 10.0.0.10, fuera de HOME_NET, por eso no se duplica.
alert icmp any any -> $HOME_NET any (msg:"ATALAYA SNORT ICMP de prueba"; classtype:misc-activity; sid:1000001; rev:1;)

# ===== Objetivo 2 · Sniffer (Wireshark) =====
# Tráfico: tshark/Wireshark en el backend con resolución de nombres activa (-N nN): pregunta al DNS de la VPC el nombre de cada IP que ve (consultas PTR).
# Por qué: Un sniffer es pasivo y no deja firma propia, pero con resolución de nombres genera consultas DNS inversas. "|07|in-addr|04|arpa|00|" es in-addr.arpa en formato DNS. Es un indicio, no una certeza: con -n (sin resolución) la alerta no aparece.
alert udp $HOME_NET any -> any 53 (msg:"ATALAYA SNORT DNS PTR - posible sniffer con resolucion de nombres"; content:"|07|in-addr|04|arpa|00|"; nocase; classtype:policy-violation; sid:1000002; rev:1;)

# Tráfico: Un inicio de sesión en el sitio: Nginx reenvía el JSON con la contraseña a 10.0.128.10:3000 por HTTP.
# Por qué: El TLS termina en el ALB/Nginx; el tramo interno por el peering viaja sin cifrar. Lo que se ve con Wireshark en el .pcap lo ve Snort en la carga útil.
alert tcp any any -> $HOME_NET 3000 (msg:"ATALAYA SNORT Credenciales en texto claro hacia la API"; flow:to_server,established; content:"|22|password|22|"; nocase; classtype:policy-violation; sid:1000004; rev:1;)

# ===== Objetivo 3 · Escaneo con Nmap =====
# Tráfico: sudo nmap -sS -p 1-200 contra el backend desde ec2-frontend: cientos de SYN a puertos distintos en pocos segundos.
# Por qué: Un cliente normal abre pocas conexiones. detection_filter solo alerta cuando el mismo origen supera 20 SYN en 5 s, que es la huella de un escaneo.
alert tcp any any -> $HOME_NET any (msg:"ATALAYA SNORT Posible escaneo SYN de puertos (nmap)"; flags:S; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000003; rev:1;)

# ===== Ampliación · sqlmap y fuerza bruta =====
# Tráfico: Más de 5 intentos de login en 60 segundos contra la API.
# Por qué: detection_filter solo alerta a partir del sexto intento en la ventana: un usuario que se equivoca una vez no la dispara.
alert tcp any any -> $HOME_NET 3000 (msg:"ATALAYA SNORT Posible fuerza bruta al login"; flow:to_server,established; content:"POST"; depth:4; content:"/api/auth/login"; within:30; detection_filter:track by_src, count 5, seconds 60; classtype:attempted-user; sid:1000005; rev:1;)

# Tráfico: sqlmap con su User-Agent por defecto contra la API.
# Por qué: sqlmap se identifica como "sqlmap/1.x". Es fácil de evadir (--random-agent), por eso se complementa con la regla 1000007.
alert tcp any any -> $HOME_NET 3000 (msg:"ATALAYA SNORT Herramienta sqlmap (User-Agent)"; flow:to_server,established; content:"User-Agent|3A| sqlmap"; nocase; classtype:web-application-attack; sid:1000006; rev:1;)

# Tráfico: Las cargas útiles de sqlmap que prueban UNION ... SELECT en los parámetros.
# Por qué: Detecta el contenido del ataque y no la herramienta: sigue funcionando aunque se cambie el User-Agent.
alert tcp any any -> $HOME_NET 3000 (msg:"ATALAYA SNORT Inyeccion SQL UNION SELECT"; flow:to_server,established; content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; classtype:web-application-attack; sid:1000007; rev:1;)

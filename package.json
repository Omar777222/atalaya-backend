{
  "name": "atalaya-backend",
  "version": "1.0.0",
  "description": "API de Atalaya: autenticación JWT, roles, auditoría y centro de monitoreo IDS (Snort + Suricata) con arquitectura hexagonal",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup": "node scripts/setup-env.js",
    "hash": "node scripts/hash-password.js",
    "demo": "node scripts/demo-alerts.js",
    "rules:export": "node scripts/export-rules.js",
    "test": "node --test test/*.test.js",
    "db:migrate": "node scripts/db-migrate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}

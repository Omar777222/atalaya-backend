# Este archivo es solo de referencia. El .env real se genera con:
#   npm run setup -- "ContraseñaAdmin" "ContraseñaAnalista"

PORT=3000
# Local: 127.0.0.1 | AWS: 0.0.0.0 (UFW y el Security Group limitan quién entra)
HOST=127.0.0.1
# Proxies confiables. Local: loopback | AWS: 10.0.0.10 (IP privada del frontend)
TRUST_PROXY=loopback

# Base de datos PostgreSQL (db/instalar-postgresql.sh la crea e imprime esta línea).
# Vacía = modo memoria (desarrollo local sin PostgreSQL).
DATABASE_URL=
DATABASE_POOL_MAX=5

JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=atalaya-api
JWT_AUDIENCE=atalaya-web

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
ANALYST_USERNAME=analista
ANALYST_PASSWORD_HASH=''

# Opcional: cliente del servicio (portal "Mi sitio"). Se crea con una 3.ª contraseña en npm run setup
CLIENT_USERNAME=cliente
CLIENT_DISPLAY_NAME=Tienda Demo
CLIENT_PASSWORD_HASH=''
SERVICE_NAME=Atalaya SOC
SERVICE_PLAN=Profesional

# ---------- IDS ----------
# Clave que comparte el backend con el agente del frontend (npm run setup la genera)
IDS_INGEST_KEY=
# Local: ./samples/alert_fast.txt | AWS: /var/log/snort/alert_fast.txt
IDS_SNORT_ALERT_FILE=/var/log/snort/alert_fast.txt
IDS_SNORT_SERVICE=snort
IDS_SNORT_HOME_NET=10.0.128.0/17
# Confírmala con: ip -br address (en instancias t2 suele ser eth0, en t3 ens5)
IDS_SNORT_INTERFACE=eth0
IDS_SURICATA_HOME_NET=10.0.0.0/17
IDS_SURICATA_INTERFACE=ens5
IDS_FRONTEND_PRIVATE_IP=10.0.0.10
IDS_BACKEND_PRIVATE_IP=10.0.128.10
# Cambia en cada sesión del Learner Lab si no usas Elastic IP (también se puede escribir en la página Demo en vivo)
IDS_FRONTEND_PUBLIC_IP=IP_PUBLICA_FRONTEND
IDS_DOMAIN=atalaya-zt.duckdns.org

# Este archivo es solo de referencia. El .env real se genera con:
#   npm run setup -- "ContraseñaAdmin" "ContraseñaAnalista"

PORT=3000
# Local: 127.0.0.1 | AWS: 0.0.0.0 (UFW y el Security Group limitan quién entra)
HOST=127.0.0.1
# Proxies confiables. Local: loopback | AWS: 10.0.0.10 (IP privada del frontend)
TRUST_PROXY=loopback

JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=atalaya-api
JWT_AUDIENCE=atalaya-web

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
ANALYST_USERNAME=analista
ANALYST_PASSWORD_HASH=''
